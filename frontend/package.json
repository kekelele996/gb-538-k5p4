  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "typescript": "5.6.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.10"
  }
